# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API. Restart `npm run dev` afterwards.
# Leave them empty to run the site on browser storage only (demo mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo mode only (when the Supabase keys above are empty): admin password for /admin/login.
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
